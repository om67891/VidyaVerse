# Class 5 Chatbot — Environment Variables
# Copy this file to .env and adjust values if needed.
# No secret API keys required — everything runs locally.

# ── Ollama ──────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_TIMEOUT=120

# ── Embedding model ──────────────────────────────────────────────────────────
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small

# ── ChromaDB ─────────────────────────────────────────────────────────────────
CHROMA_COLLECTION_NAME=class5_evs_chapters

# ── RAG parameters ───────────────────────────────────────────────────────────
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=1.5
RAG_MAX_CONTEXT_CHARS=4000

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the FastAPI backend.
# CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
